# Copy this file to config/.env for local development. Docker injects these
# values into the container; PHP's dotenv loader should remain disabled.
APP_NAME=qr.fr3nch.com
DEBUG=true
APP_ENCODING=UTF-8
APP_DEFAULT_LOCALE=en_US
APP_DEFAULT_TIMEZONE=UTC
APP_FULL_BASE_URL=http://localhost:8081
SECURITY_SALT=replace-with-a-local-development-salt
DATABASE_URL=sqlite:////var/www/html/tmp/prod.sqlite

# Uncomment these to define cache configuration via environment variables.
# CACHE_DURATION=+2 minutes
# CACHE_DEFAULT_URL=file:///path/to/tmp/cache/?prefix=app_default_&duration=+2 minutes
# CACHE_CAKECORE_URL=file:///path/to/tmp/cache/persistent?prefix=app_cake_core_&serialize=true&duration=+2 minutes
# CACHE_CAKEMODEL_URL=file:///path/to/tmp/cache/models?prefix=app_cake_model_&serialize=true&duration=+2 minutes

# Uncomment these to define email transport configuration via environment variables.
# EMAIL_TRANSPORT_DEFAULT_URL=

# Uncomment these to define database configuration via environment variables.
# DATABASE_URL=mysql://my_app:secret@database/my_app?encoding=utf8mb4&timezone=UTC
# DATABASE_TEST_URL=sqlite:////var/www/html/tmp/testdb.sqlite

# Uncomment these to define logging configuration via environment variables.
# LOG_DEBUG_URL=file:///path/to/logs/?levels[]=notice&levels[]=info&levels[]=debug&file=debug
# LOG_ERROR_URL=file:///path/to/logs/?levels[]=warning&levels[]=error&levels[]=critical&levels[]=alert&levels[]=emergency&file=error

# AWS S3 configuration for persistent cache and file uploads.
# AWS_S3_ACCESS_KEY_ID=your-aws-access-key
# AWS_S3_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_S3_REGION=your-aws-region
# AWS_S3_BUCKET=your-aws-bucket-name
# AWS_S3_ENV=development
# AWS_S3_PREFIX=qr.fr3nch.com

# Flysystem uses local storage by default. Set the driver to s3 to store uploads in S3.
# FILESYSTEM_DRIVER=s3|local
# FILESYSTEM_LOCAL_PATH=/var/www/html/tmp/uploads
# If FILESYSTEM_PREFIX isn't set, it will use AWS_S3_PREFIX and AWS_S3_ENV 
# FILESYSTEM_PREFIX=qr.fr3nch.com/development/uploads