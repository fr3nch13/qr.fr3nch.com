{
    "name": "fr3nch13/qr.fr3nch.com",
    "description": "App for qr.fr3nch.com",
    "homepage": "https://qr.fr3nch.com",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Brian French",
            "homepage": "https://fr3nch.com"
        }
    ],
    "require": {
        "php": ">=8.5",
        "aws/aws-sdk-php": "^3.390.4",
        "cakephp/authentication": "^3.3.7",
        "cakephp/authorization": "^3.5.3",
        "cakephp/cakephp": "^5.4.1",
        "cakephp/migrations": "^5.2.6",
        "cakephp/plugin-installer": "^2.0.2",
        "chillerlan/php-qrcode": "^5.0.5",
        "fr3nch13/cakephp-stats": "^1.0.0",
        "friendsofcake/bootstrap-ui": "^5.2.0",
        "friendsofcake/search": "^7.9",
        "league/flysystem": "^3.35.2",
        "league/flysystem-aws-s3-v3": "^3.35.2",
        "mobiledetect/mobiledetectlib": "^4.11.0",
        "paragonie/csp-builder": "^3.0.2",
        "robmorgan/phinx": "^0.16.12"
    },
    "require-dev": {
        "cakephp/bake": "^3.8.1",
        "cakephp/cakephp-codesniffer": "^5.3.1",
        "cakephp/debug_kit": "^5.2.4",
        "josegonzalez/dotenv": "^4.0",
        "phpstan/phpstan": "^2.2.7",
        "phpunit/phpunit": "^13.2.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "App\\Migrations\\": "config/Migrations"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Test\\": "tests/",
            "App\\Test\\Fixture\\": "tests/Fixture",
            "Cake\\Test\\": "vendor/cakephp/cakephp/tests"
        }
    },
    "scripts": {
        "assets:install": [
            "npm ci",
            "npm run build"
        ],
        "assets:update": [
            "npm update",
            "npm run build"
        ],
        "post-install-cmd": [
            "App\\Console\\Installer::postInstall",
            "@assets:install",
            "@migrate"
        ],
        "post-update-cmd": [
            "@assets:update",
            "@migrate"
        ],
        "post-create-project-cmd": [
            "App\\Console\\Installer::postInstall",
            "@assets:install"
        ],
        "migrate": [
            "bin/cake migrations upgrade",
            "bin/cake migration_ids",
            "bin/cake migrations migrate"
        ],
        "seed": "bin/cake seeds run",
        "ci": [
            "@check",
            "@coverage-text"
        ],
        "check": [
            "@test",
            "@cs-check",
            "@phpstan"
        ],
        "fix": [
            "@cs-fix",
            "@cs-check"
        ],
        "actionlint": "/usr/local/bin/actionlint .github/workflows/*.yml",
        "deploy-test": "sh tests/deploy/transactional-rollback.sh",
        "cs-check": "php -d memory_limit=-1 ./vendor/bin/phpcs --colors -p -s",
        "cs-fix": "php -d memory_limit=-1 ./vendor/bin/phpcbf --colors -p",
        "cs-checkstyle": "@cs-check -- --report=checkstyle",
        "test": "php -d memory_limit=-1 ./vendor/bin/phpunit --colors=always",
        "phpstan": "php -d memory_limit=-1 ./vendor/bin/phpstan --no-progress -vvv",
        "phpstan-github": "php -d memory_limit=-1 ./vendor/bin/phpstan --no-progress -vvv --error-format=github",
        "coverage": "php -d memory_limit=-1 -d xdebug.mode=coverage ./vendor/bin/phpunit --coverage-html tmp/coverage --coverage-clover=tmp/cov.xml",
        "coverage-clover": "php -d memory_limit=-1 -d xdebug.mode=coverage ./vendor/bin/phpunit --coverage-clover=tmp/coverage.xml",
        "coverage-text": "php -d memory_limit=-1 -d xdebug.mode=coverage ./vendor/bin/phpunit --coverage-text --colors=never"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "platform-check": true,
        "sort-packages": true,
        "allow-plugins": {
            "cakephp/plugin-installer": true,
                "dealerdirect/phpcodesniffer-composer-installer": true,
            "composer/installers": false
        }
    }
}
